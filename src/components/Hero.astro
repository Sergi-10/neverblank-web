---
import { APP_REGISTER_URL, EXTERNAL_LINK_ATTRS } from "../data/site";
---

<section
  id="hero-section"
  class="relative flex min-h-screen items-center overflow-hidden bg-brand-navy pt-32"
>
  <div
    id="hero-icon-watermark"
    class="pointer-events-none absolute left-1/2 top-1/2 h-[350%] w-[350%]"
    style="--zoom-progress: 0; transform: translate(-50%, -50%) scale(calc(1 + var(--zoom-progress) * 0.5)); transform-origin: center;"
  >
    <div class="hero-icon-float h-full w-full">
      <svg viewBox="0 0 296.49 225.39" class="h-full w-full fill-current text-white/[0.13]" aria-hidden="true">
        <path d="M227.6,59.02c6.7,0,12.15,5.45,12.15,12.15v88.25c0,6.7-5.45,12.15-12.15,12.15H64.64v-100.4c0-6.7,5.45-12.15,12.15-12.15h150.8M227.6,39.02H76.8c-17.76,0-32.15,14.4-32.15,32.15v120.4h182.95c17.76,0,32.15-14.4,32.15-32.15v-88.25c0-17.76-14.4-32.15-32.15-32.15h0Z" />
        <polygon points="146.57 96.47 136.83 86.73 115.14 108.41 93.45 86.73 83.71 96.47 105.4 118.16 83.71 139.84 93.45 149.59 115.14 127.9 136.83 149.59 146.57 139.84 124.88 118.16 146.57 96.47" />
        <rect x="161.83" y="86.65" width="63" height="63" rx="5.97" ry="5.97" />
      </svg>
    </div>
  </div>

  <div class="relative z-10 mx-auto grid w-full max-w-6xl gap-10 px-6 py-24 text-center md:grid-cols-2 md:items-center md:text-left">
    <h1 class="font-display text-6xl font-bold tracking-tight text-white md:text-8xl">
      <span class="block">Gestiona tu</span>
      <span class="block text-brand-orange">contenido.</span>
      <span class="block">Sin excusas.</span>
    </h1>

    <div class="flex flex-col items-center md:items-end">
      <p class="text-base text-white/70 md:max-w-[260px] md:text-right md:text-lg">
        La plataforma para agencias y freelances que necesitan tener el control total de sus
        clientes, publicaciones y estrategia.
      </p>

      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row md:items-end">
        <a
          href={APP_REGISTER_URL}
          target={EXTERNAL_LINK_ATTRS.target}
          rel={EXTERNAL_LINK_ATTRS.rel}
          class="rounded-full bg-brand-orange px-8 py-3 text-base font-semibold text-white transition-colors hover:bg-brand-orange/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Registrarse
        </a>
        <a
          href="#precios"
          class="rounded-full border border-white/40 px-8 py-3 text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Ver planes
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.getElementById("hero-section");
  const icon = document.getElementById("hero-icon-watermark");
  let ticking = false;

  const updateZoom = () => {
    if (!hero || !icon) return;
    const progress = Math.min(Math.max(window.scrollY / hero.offsetHeight, 0), 1);
    icon.style.setProperty("--zoom-progress", progress.toString());
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      requestAnimationFrame(updateZoom);
      ticking = true;
    }
  };

  updateZoom();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  .hero-icon-float {
    animation: float-circle 40s ease infinite;
  }

  @keyframes float-circle {
    0% {
      transform: translate(27px, 0px);
    }
    12.5% {
      transform: translate(19px, 19px);
    }
    25% {
      transform: translate(0px, 27px);
    }
    37.5% {
      transform: translate(-19px, 19px);
    }
    50% {
      transform: translate(-27px, 0px);
    }
    62.5% {
      transform: translate(-19px, -19px);
    }
    75% {
      transform: translate(0px, -27px);
    }
    87.5% {
      transform: translate(19px, -19px);
    }
    100% {
      transform: translate(27px, 0px);
    }
  }
</style>
