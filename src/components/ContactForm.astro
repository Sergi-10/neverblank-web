---
interface Props {
  /** Prefijo de los id/for para poder usar el formulario más de una vez sin duplicar ids */
  idPrefix?: string;
  class?: string;
}

const { idPrefix = "contact", class: className = "" } = Astro.props;

// Slots opcionales: "info" (fila de email/teléfono, para que la imagen de
// "aside" empiece a su misma altura), "aside" (imagen junto a Info/Nombre/
// Email/Asunto) y "secondary" (link alternativo junto al botón Enviar). Si
// no se rellenan (p. ej. en /contacto), el formulario cae al layout simple
// de una columna.
const hasInfo = Astro.slots.has("info");
const hasAside = Astro.slots.has("aside");
const hasSecondary = Astro.slots.has("secondary");
---

<!--
  Formulario de contacto (maqueta visual, sin backend).
  TODO: conectar aquí el envío real — añadir `action` / `method` al <form>,
  o un handler de submit que llame al endpoint correspondiente.
  No hay integración activa: no se simula ninguna respuesta de servidor.
-->
<form class={`space-y-8 ${className}`} data-contact-form>
  {hasAside ? (
    <div class="grid gap-8 md:grid-cols-2 md:items-stretch">
      <div class="space-y-8">
        {hasInfo && (
          <div>
            <slot name="info" />
          </div>
        )}
        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <label
              class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
              for={`${idPrefix}-name`}
            >
              Nombre *
            </label>
            <input
              id={`${idPrefix}-name`}
              name="name"
              type="text"
              required
              class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
            />
          </div>
          <div>
            <label
              class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
              for={`${idPrefix}-email`}
            >
              Email *
            </label>
            <input
              id={`${idPrefix}-email`}
              name="email"
              type="email"
              required
              class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label
            class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
            for={`${idPrefix}-subject`}
          >
            Asunto *
          </label>
          <input
            id={`${idPrefix}-subject`}
            name="subject"
            type="text"
            required
            class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
          />
        </div>
      </div>

      <div class="hidden md:flex">
        <slot name="aside" />
      </div>
    </div>
  ) : (
    <Fragment>
      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <label
            class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
            for={`${idPrefix}-name`}
          >
            Nombre *
          </label>
          <input
            id={`${idPrefix}-name`}
            name="name"
            type="text"
            required
            class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
          />
        </div>
        <div>
          <label
            class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
            for={`${idPrefix}-email`}
          >
            Email *
          </label>
          <input
            id={`${idPrefix}-email`}
            name="email"
            type="email"
            required
            class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label
          class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
          for={`${idPrefix}-subject`}
        >
          Asunto *
        </label>
        <input
          id={`${idPrefix}-subject`}
          name="subject"
          type="text"
          required
          class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
        />
      </div>
    </Fragment>
  )}

  <div>
    <label
      class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
      for={`${idPrefix}-message`}
    >
      Mensaje
    </label>
    <textarea
      id={`${idPrefix}-message`}
      name="message"
      rows="5"
      class="mt-2 h-[150px] w-full resize-none border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
    ></textarea>
  </div>

  <label class="flex items-start gap-3 text-sm text-gray-600" for={`${idPrefix}-privacy`}>
    <input
      id={`${idPrefix}-privacy`}
      name="privacy"
      type="checkbox"
      required
      class="mt-1 h-4 w-4 rounded border-gray-300 text-brand-orange focus:ring-brand-orange"
    />
    Sí, estoy de acuerdo con la política de privacidad y condiciones generales.
  </label>

  {hasSecondary ? (
    <div class="contact-actions gap-x-6 gap-y-3 border-t border-gray-200 pt-6">
      <div class="contact-actions-submit">
        <button
          type="submit"
          class="rounded-full bg-brand-orange px-10 py-3 text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-brand-orange/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-orange"
        >
          Enviar
        </button>
      </div>
      <div class="contact-actions-divider" aria-hidden="true"></div>
      <p class="contact-actions-note text-sm font-semibold text-brand-navy">
        O si prefieres probar el programa
      </p>
      <div class="contact-actions-login">
        <slot name="secondary" />
      </div>
    </div>
  ) : (
    <button
      type="submit"
      class="rounded-full bg-brand-orange px-10 py-3 text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-brand-orange/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-orange"
    >
      Enviar
    </button>
  )}
</form>

<style>
  /*
    Fila final: Enviar y el link "secondary" (Iniciar sesión) deben quedar
    exactamente a la misma altura, sin que la nota de arriba los descuadre.
    Áreas nombradas en vez de flex: en el layout de escritorio "submit" y
    "login" viven en la MISMA fila del grid (nada más comparte esa fila), así
    que su centro vertical coincide por construcción — no depende de cuánto
    mida la nota.
  */
  .contact-actions {
    display: grid;
    grid-template-areas: "submit" "note" "login";
  }

  .contact-actions-submit {
    grid-area: submit;
  }

  .contact-actions-note {
    grid-area: note;
  }

  .contact-actions-login {
    grid-area: login;
  }

  .contact-actions-divider {
    display: none;
  }

  @media (min-width: 640px) {
    .contact-actions {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      grid-template-areas:
        ".      divider note"
        "submit divider login";
    }

    .contact-actions-divider {
      display: block;
      grid-area: divider;
      width: 1px;
      height: 100%;
      background-color: var(--color-gray-200, #e5e7eb);
    }
  }
</style>
