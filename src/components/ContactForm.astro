---
interface Props {
  /** Prefijo de los id/for para poder usar el formulario más de una vez sin duplicar ids */
  idPrefix?: string;
  class?: string;
}

const { idPrefix = "contact", class: className = "" } = Astro.props;

// Slots opcionales: "info" (fila de email/teléfono, para que la imagen de
// "aside" empiece a su misma altura), "aside" (imagen junto a Info/Nombre/
// Email/Asunto) y "secondary" (link alternativo junto al botón Enviar). Si
// no se rellenan (p. ej. en /contacto), el formulario cae al layout simple
// de una columna.
const hasInfo = Astro.slots.has("info");
const hasAside = Astro.slots.has("aside");
const hasSecondary = Astro.slots.has("secondary");
---

<!--
  Formulario de contacto: el envío real va por fetch a /api/contact (ver
  script al final de este archivo), no por action/method nativos del <form>.
-->
<form class={`space-y-8 ${className}`} data-contact-form>
  {hasAside ? (
    <div class="grid gap-8 md:grid-cols-2 md:items-stretch">
      <div class="space-y-8">
        {hasInfo && (
          <div>
            <slot name="info" />
          </div>
        )}
        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <label
              class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
              for={`${idPrefix}-name`}
            >
              Nombre *
            </label>
            <input
              id={`${idPrefix}-name`}
              name="name"
              type="text"
              required
              class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
            />
          </div>
          <div>
            <label
              class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
              for={`${idPrefix}-email`}
            >
              Email *
            </label>
            <input
              id={`${idPrefix}-email`}
              name="email"
              type="email"
              required
              class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label
            class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
            for={`${idPrefix}-subject`}
          >
            Asunto *
          </label>
          <input
            id={`${idPrefix}-subject`}
            name="subject"
            type="text"
            required
            class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
          />
        </div>
      </div>

      <div class="hidden md:flex">
        <slot name="aside" />
      </div>
    </div>
  ) : (
    <Fragment>
      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <label
            class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
            for={`${idPrefix}-name`}
          >
            Nombre *
          </label>
          <input
            id={`${idPrefix}-name`}
            name="name"
            type="text"
            required
            class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
          />
        </div>
        <div>
          <label
            class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
            for={`${idPrefix}-email`}
          >
            Email *
          </label>
          <input
            id={`${idPrefix}-email`}
            name="email"
            type="email"
            required
            class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label
          class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
          for={`${idPrefix}-subject`}
        >
          Asunto *
        </label>
        <input
          id={`${idPrefix}-subject`}
          name="subject"
          type="text"
          required
          class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
        />
      </div>
    </Fragment>
  )}

  <div>
    <label
      class="block text-xs font-semibold uppercase tracking-wide text-gray-500"
      for={`${idPrefix}-message`}
    >
      Mensaje
    </label>
    <textarea
      id={`${idPrefix}-message`}
      name="message"
      rows="5"
      class="mt-2 h-[150px] w-full resize-none border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
    ></textarea>
  </div>

  <label class="flex items-start gap-3 text-sm text-gray-600" for={`${idPrefix}-privacy`}>
    <input
      id={`${idPrefix}-privacy`}
      name="privacy"
      type="checkbox"
      required
      class="mt-1 h-4 w-4 rounded border-gray-300 text-brand-orange focus:ring-brand-orange"
    />
    Sí, estoy de acuerdo con la política de privacidad y condiciones generales.
  </label>

  {hasSecondary ? (
    <div class="contact-actions gap-x-6 gap-y-3 border-t border-gray-200 pt-6">
      <div class="contact-actions-submit">
        <button
          type="submit"
          class="rounded-full bg-brand-orange px-10 py-3 text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-brand-orange/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-orange"
        >
          Enviar
        </button>
      </div>
      <div class="contact-actions-divider" aria-hidden="true"></div>
      <p class="contact-actions-note text-sm font-semibold text-brand-navy">
        O si ya tienes cuenta
      </p>
      <div class="contact-actions-login">
        <slot name="secondary" />
      </div>
    </div>
  ) : (
    <button
      type="submit"
      class="rounded-full bg-brand-orange px-10 py-3 text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-brand-orange/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-orange"
    >
      Enviar
    </button>
  )}
</form>

<script>
  type Tone = "warning" | "success" | "error";

  const TONE_STYLES: Record<Tone, { border: string; icon: string }> = {
    warning: { border: "border-brand-orange", icon: "ti-alert-triangle text-brand-orange" },
    success: { border: "border-brand-orange", icon: "ti-circle-check text-brand-orange" },
    error: { border: "border-red-500", icon: "ti-alert-circle text-red-500" },
  };

  function getToastRegion(): HTMLElement {
    let region = document.getElementById("contact-toast-region");
    if (!region) {
      region = document.createElement("div");
      region.id = "contact-toast-region";
      region.setAttribute("aria-live", "polite");
      region.className =
        "pointer-events-none fixed inset-x-4 top-24 z-[100] flex flex-col items-stretch gap-2 sm:inset-x-auto sm:right-6 sm:items-end";
      document.body.appendChild(region);
    }
    return region;
  }

  function showToast(message: string, tone: Tone) {
    const region = getToastRegion();
    const { border, icon } = TONE_STYLES[tone];

    const toast = document.createElement("div");
    toast.className = `pointer-events-auto flex w-full max-w-sm items-start gap-3 rounded-xl border-l-4 ${border} bg-white p-4 text-sm text-brand-navy shadow-[0_20px_45px_-15px_rgba(20,40,60,0.45)]`;

    const iconEl = document.createElement("i");
    iconEl.className = `ti ${icon} mt-0.5 text-lg`;
    iconEl.setAttribute("aria-hidden", "true");

    const textEl = document.createElement("p");
    textEl.className = "flex-1";
    textEl.textContent = message;

    const closeButton = document.createElement("button");
    closeButton.type = "button";
    closeButton.className = "shrink-0 text-gray-400 transition-colors hover:text-brand-navy";
    closeButton.setAttribute("aria-label", "Cerrar aviso");
    const closeIcon = document.createElement("i");
    closeIcon.className = "ti ti-x";
    closeIcon.setAttribute("aria-hidden", "true");
    closeButton.appendChild(closeIcon);

    const dismiss = () => toast.remove();
    closeButton.addEventListener("click", dismiss);

    toast.append(iconEl, textEl, closeButton);
    region.appendChild(toast);
    setTimeout(dismiss, 4000);
  }

  const REQUIRED_FIELDS: { field: string; label: string }[] = [
    { field: "name", label: "Nombre" },
    { field: "email", label: "Email" },
    { field: "subject", label: "Asunto" },
  ];

  function initContactForm(form: HTMLFormElement) {
    if (form.dataset.contactReady === "1") return;
    form.dataset.contactReady = "1";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const missing = REQUIRED_FIELDS.filter(
        ({ field }) => !String(data.get(field) ?? "").trim()
      );

      if (missing.length > 0) {
        showToast(`Falta rellenar: ${missing.map((m) => m.label).join(", ")}`, "warning");
        return;
      }

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submitButton?.setAttribute("disabled", "true");

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            nombre: data.get("name"),
            email: data.get("email"),
            asunto: data.get("subject"),
            mensaje: data.get("message"),
          }),
        });

        if (!response.ok) throw new Error("request-failed");

        showToast("Mensaje enviado correctamente, te responderemos pronto.", "success");
        form.reset();
      } catch {
        showToast(
          "No se ha podido enviar el mensaje, inténtalo de nuevo o escríbenos a hello@neverblanc.com",
          "error"
        );
      } finally {
        submitButton?.removeAttribute("disabled");
      }
    });
  }

  document
    .querySelectorAll<HTMLFormElement>("[data-contact-form]")
    .forEach(initContactForm);
</script>

<style>
  /*
    Fila final: Enviar y el link "secondary" (Iniciar sesión) deben quedar
    exactamente a la misma altura, sin que la nota de arriba los descuadre.
    Áreas nombradas en vez de flex: en el layout de escritorio "submit" y
    "login" viven en la MISMA fila del grid (nada más comparte esa fila), así
    que su centro vertical coincide por construcción — no depende de cuánto
    mida la nota.
  */
  .contact-actions {
    display: grid;
    grid-template-areas: "submit" "note" "login";
  }

  .contact-actions-submit {
    grid-area: submit;
  }

  .contact-actions-note {
    grid-area: note;
  }

  .contact-actions-login {
    grid-area: login;
  }

  .contact-actions-divider {
    display: none;
  }

  @media (min-width: 640px) {
    .contact-actions {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      grid-template-areas:
        ".      divider note"
        "submit divider login";
    }

    .contact-actions-divider {
      display: block;
      grid-area: divider;
      width: 1px;
      height: 100%;
      background-color: var(--color-gray-200, #e5e7eb);
    }
  }
</style>
