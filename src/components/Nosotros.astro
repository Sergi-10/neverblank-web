---
import ProcessSteps from "./ProcessSteps.astro";
import ProductShowcase from "./ProductShowcase.astro";
import { agencyPainSteps } from "../data/site";
---

{/*
  Un único id="nosotros" para todo el bloque narrativo: quiénes somos, el
  problema (agencyPainSteps) y la solución (ordenador + ProductShowcase).
  No crear anclas nuevas de "problema"/"solución": todo cuelga de esta.
*/}
<section id="nosotros" class="scroll-mt-20 bg-brand-bg">
  <div class="mx-auto grid max-w-6xl gap-20 px-6 py-24 md:grid-cols-[1.3fr_1fr] md:items-start">
    <div class="reveal-up md:pl-6">
      <h2 class="font-display text-4xl font-bold text-brand-navy md:text-5xl">
        ¡Hola! Somos el equipo detrás de <span class="text-brand-orange">NeverBlanc</span>.
      </h2>

      {/* Sin clase de color: hereda el color de texto normal del body. */}
      <p class="mt-6">
        <span class="text-brand-orange">
          La plataforma que reúne estrategia, calendario y contenido en un solo lugar
        </span>, pensada para agencias y freelances que gestionan varias cuentas y no tienen
        tiempo que perder. Centraliza la planificación, crea contenido con inteligencia
        artificial y evita empezar de cero cada vez que toca publicar.
      </p>
    </div>

    {/* El ensanchado sólo desde xl: por debajo el contenedor mide lo que el
        viewport y un 112% provocaría scroll horizontal. */}
    <div class="reveal-up group relative md:mt-16 xl:-mr-8 xl:w-[112%]">
      {/*
        `nosotros__solucion` es la imagen base: en móvil (sin hover) es la única
        visible y, por tanto, la primera imagen del cuerpo. En escritorio queda
        debajo de `nosotros_problema`, que se desvanece al pasar el ratón.
      */}
      <img
        src="/nosotros__solucion.png"
        alt="El orden con NeverBlanc"
        class="w-full rounded-xl object-cover shadow-[0_32px_64px_-12px_rgba(20,40,60,0.45)]"
      />
      <img
        src="/nosotros_problema.png"
        alt="El caos antes de NeverBlanc"
        aria-hidden="true"
        class="absolute inset-0 hidden h-full w-full rounded-xl object-cover shadow-[0_32px_64px_-12px_rgba(20,40,60,0.45)] transition-opacity duration-500 ease md:block md:group-hover:opacity-0"
      />
    </div>
  </div>

  {/* Problema: cómo trabaja una agencia SIN NeverBlanc. */}
  <div class="relative overflow-x-clip bg-brand-navy pb-4 pt-16 md:pt-24">
    <div
      class="pointer-events-none absolute -left-40 -top-32 h-[26rem] w-[26rem] rounded-full border-2 border-brand-orange/25"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-24 -top-24 hidden h-[18rem] w-[18rem] rounded-full border-2 border-brand-gradient-blue/20 md:block"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute left-1/4 top-4 hidden h-[9rem] w-[9rem] rounded-full border-2 border-white/10 lg:block"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-6xl px-6">
      <div class="reveal-up text-center">
        <h3 class="font-display text-3xl font-bold text-white md:text-4xl">
          Antes de <span class="text-brand-orange">NeverBlanc</span>, todo vive separado.
        </h3>
        <p class="mt-4 text-base text-white/60 md:text-lg">
          Documentos, Excels, chats y prompts sueltos. El problema no es crear contenido: es
          mantenerlo todo conectado.
        </p>
      </div>

      <ProcessSteps steps={agencyPainSteps} />
    </div>
  </div>

  {/* Solución: ordenador + ProductShowcase. Mismo fondo navy que el bloque
      anterior, sin salto visual entre ambos. */}
  <div class="relative overflow-x-clip bg-brand-navy pb-16 pt-12 md:pb-24 md:pt-16">
    <div
      class="pointer-events-none absolute -right-48 top-1/3 h-[31rem] w-[31rem] rounded-full border-2 border-white/15"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -left-24 bottom-16 h-[16rem] w-[16rem] rounded-full border-2 border-brand-gradient-blue/20"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute right-10 bottom-0 hidden h-[10rem] w-[10rem] rounded-full border-2 border-brand-orange/20 lg:block"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-6xl px-6">
      <div class="reveal-up mx-auto max-w-2xl text-center">
        <p class="font-display text-lg font-semibold text-white sm:whitespace-nowrap sm:text-2xl md:text-3xl">
          <span class="text-brand-orange">NeverBlanc</span>. Menos Excel, más estrategia:
        </p>
      </div>

      {/*
        Composición: ordenador (PNG transparente, sin tarjeta ni sombra) a la
        izquierda y ProductShowcase en un contenedor oscuro a la derecha, con
        el showcase desplazado hacia arriba para romper la alineación y dar
        una composición más dinámica. En móvil se apilan sin desfase.
      */}
      <div class="reveal-up mt-8 grid items-end gap-6 md:mt-12 md:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] md:gap-4 lg:gap-5">
        <img
          src="/ordenador_inicio.png"
          alt="Calendario de contenido de NeverBlanc abierto en un ordenador portátil"
          class="mx-auto hidden h-auto w-full max-w-[38rem] object-contain md:block"
        />

        <div class="w-full max-w-[28rem] justify-self-center md:max-w-none md:-translate-y-8 md:justify-self-end lg:-translate-y-10">
          <ProductShowcase variant="embedded" />
        </div>
      </div>
    </div>
  </div>
</section>
