---
import ProcessSteps from "./ProcessSteps.astro";
import ProductShowcase from "./ProductShowcase.astro";
import TypewriterLine from "./TypewriterLine.astro";
import { agencyPainSteps } from "../data/site";
---

{/*
  Ancla única (como-funciona) para todo el bloque: el problema
  (agencyPainSteps) y la solución (ordenador + ProductShowcase). No crear
  anclas nuevas de "problema"/"solución": todo cuelga de esta.
*/}
<section id="como-funciona" class="scroll-mt-20 bg-brand-bg">
  {/* Problema: cómo trabaja una agencia SIN NeverBlanc. */}
  <div class="relative overflow-x-clip bg-brand-navy pb-4 pt-16 md:pt-24">
    <div
      class="pointer-events-none absolute -left-40 -top-32 h-[26rem] w-[26rem] rounded-full border-[20px] border-brand-orange/25"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-24 -top-24 hidden h-[18rem] w-[18rem] rounded-full border-[20px] border-brand-gradient-blue/20 md:block"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute left-1/4 top-4 hidden h-[9rem] w-[9rem] rounded-full border-[14px] border-white/10 lg:block"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-6xl px-6">
      <div class="reveal-up text-center">
        <h3 class="font-display text-3xl font-bold text-white md:text-4xl">
          Antes de <span class="text-brand-orange">NeverBlanc</span>, todo vive separado.
        </h3>
        <p class="mt-4 text-base text-white/60 md:text-lg">
          Documentos, Excels, chats y prompts sueltos. El problema no es crear contenido: es
          mantenerlo todo conectado.
        </p>
      </div>

      <ProcessSteps steps={agencyPainSteps} />
    </div>
  </div>

  {/* Solución: ordenador + ProductShowcase. Mismo fondo navy que el bloque
      anterior, sin salto visual entre ambos. */}
  <div class="relative overflow-x-clip bg-brand-navy pb-16 pt-12 md:pb-24 md:pt-16">
    <div
      class="pointer-events-none absolute -right-48 top-1/3 h-[31rem] w-[31rem] rounded-full border-[20px] border-white/15"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -left-24 bottom-16 h-[16rem] w-[16rem] rounded-full border-[20px] border-brand-gradient-blue/20"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute right-10 bottom-0 hidden h-[10rem] w-[10rem] rounded-full border-[14px] border-brand-orange/20 lg:block"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-[90rem] px-6">
      <div class="reveal-up mx-auto max-w-2xl text-center">
        <TypewriterLine
          words={["organizar", "planificar", "gestionar"]}
          suffix="tu contenido"
          class="justify-center text-base font-semibold text-white/70"
        />
        <p class="mt-2 font-display text-lg font-semibold text-white sm:whitespace-nowrap sm:text-2xl md:text-3xl">
          Así funciona por dentro
        </p>
        <p class="mt-3 text-sm text-white/60 md:text-base">
          Siete pasos, un mismo sitio, cero prompts sueltos.
        </p>
      </div>

      {/*
        Composición: ordenador (PNG transparente, sin tarjeta ni sombra) a la
        izquierda y ProductShowcase en un contenedor oscuro a la derecha, con
        el showcase desplazado hacia arriba para romper la alineación y dar
        una composición más dinámica. En móvil se apilan sin desfase.
      */}
      <div class="reveal-up mt-8 grid items-end gap-6 overflow-visible md:mt-12 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] md:gap-4 lg:gap-5">
        <img
          src="/ordenador_inicio.png"
          alt="Calendario de contenido de NeverBlanc abierto en un ordenador portátil"
          class="mx-auto hidden h-auto w-full max-w-[66rem] object-contain md:block md:-ml-6 lg:-ml-10"
        />

        <div class="relative z-10 w-full max-w-[28rem] justify-self-center md:max-w-none md:-translate-y-8 md:justify-self-end lg:-translate-y-10">
          <ProductShowcase variant="embedded" />
        </div>
      </div>
    </div>
  </div>
</section>
