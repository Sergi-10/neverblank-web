---
const navLinks = [
  { label: "Servicios", href: "/servicios" },
  { label: "Contáctanos", href: "/#contacto" },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-colors duration-300">
  <div class="mx-auto flex max-w-7xl items-center justify-between pl-3 pr-4 py-6">
    <a href="/" class="flex items-center">
      <img src="/neverblanc_logo.svg" alt="NeverBlanc" class="-ml-2 h-20 w-auto" />
    </a>

    <div class="flex items-center gap-8">
      <nav class="hidden items-center gap-8 md:flex">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-base font-medium text-white/80 transition-colors hover:text-brand-orange"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-4">
        <a
          href="/app/login"
          class="text-lg font-medium text-white/80 transition-colors hover:text-brand-orange"
        >
          Ir al programa
        </a>
        <a
          href="/app/registro"
          class="rounded-full bg-brand-orange px-7 py-3 text-lg font-semibold text-white transition-colors hover:bg-brand-orange/90"
        >
          Registrarse
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");

  const onScroll = () => {
    if (window.scrollY > 10) {
      header?.classList.add("bg-brand-navy", "shadow-sm");
    } else {
      header?.classList.remove("bg-brand-navy", "shadow-sm");
    }
  };

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  let lastScrollY = window.scrollY;
  let tickingDirection = false;

  const updateDirection = () => {
    const currentY = window.scrollY;
    if (currentY > lastScrollY && currentY > 80) {
      header?.classList.add("header-hidden");
    } else {
      header?.classList.remove("header-hidden");
    }
    lastScrollY = currentY;
    tickingDirection = false;
  };

  const onScrollDirection = () => {
    if (!tickingDirection) {
      requestAnimationFrame(updateDirection);
      tickingDirection = true;
    }
  };

  window.addEventListener("scroll", onScrollDirection, { passive: true });
</script>

<style>
  #site-header {
    max-height: 128px;
    overflow: hidden;
    transition:
      background-color 300ms ease,
      max-height 700ms ease;
  }

  #site-header.header-hidden {
    max-height: 0px;
  }
</style>
