---
---

<section id="contacto" class="mx-auto mt-16 max-w-6xl scroll-mt-24 px-6 py-8">
  <div class="grid gap-10 md:grid-cols-2 md:items-end">
    <div>
      <span class="text-sm font-semibold uppercase tracking-widest text-brand-orange">
        ¿En qué podemos ayudarte?
      </span>
      <h2 class="font-display mt-3 text-4xl font-bold text-brand-navy md:text-5xl">
        Contacta con nosotros
      </h2>
    </div>

    <div class="flex flex-col gap-6 sm:flex-row md:justify-end">
      <div>
        <i class="ti ti-mail text-[40px] text-brand-orange"></i>
        <p class="mt-2 font-semibold text-brand-orange">info@neverblanc.com</p>
        <p class="text-sm text-gray-500">Email de contacto</p>
      </div>
      <div>
        <i class="ti ti-phone text-[40px] text-brand-orange"></i>
        <p class="mt-2 font-semibold text-brand-orange">+34 600 000 000</p>
        <p class="text-sm text-gray-500">Teléfono de contacto</p>
      </div>
    </div>
  </div>

  <form class="mt-12 space-y-8">
    <div class="grid gap-8 sm:grid-cols-2">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500" for="contact-name">
          Nombre *
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
        />
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500" for="contact-email">
          Email *
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
        />
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500" for="contact-subject">
        Asunto *
      </label>
      <input
        id="contact-subject"
        name="subject"
        type="text"
        required
        class="mt-2 w-full border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
      />
    </div>

    <div>
      <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500" for="contact-message">
        Mensaje
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        class="mt-2 h-[150px] w-full resize-none border-b border-gray-300 bg-transparent py-2 text-brand-navy focus:border-brand-orange focus:outline-none"
      ></textarea>
    </div>

    <label class="flex items-start gap-3 text-sm text-gray-600">
      <input
        type="checkbox"
        required
        class="mt-1 h-4 w-4 rounded border-gray-300 text-brand-orange focus:ring-brand-orange"
      />
      Sí, estoy de acuerdo con la política de privacidad y condiciones generales.
    </label>

    <button
      type="submit"
      class="rounded-full bg-brand-orange px-10 py-3 text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-brand-orange/90"
    >
      Enviar
    </button>
  </form>
</section>
