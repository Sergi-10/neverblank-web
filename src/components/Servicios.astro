---
import ServiceScene from "./ServiceScene.astro";
import { services } from "../data/site";

// Problema en 2-3 líneas: arranque real de paragraphs[0] (la parte del
// "antes"), cortado justo donde ese párrafo empieza a hablar de NeverBlanc.
const problemTexts = services.map(
  (service) => service.paragraphs[0].split("NeverBlanc")[0].trim()
);
---

<section class="relative overflow-x-clip bg-brand-bg">
  <div class="relative z-10 mx-auto max-w-6xl px-6 py-16 md:py-20">
    {services.map((service, i) => {
      const reversed = i % 2 === 1;
      const panelId = `servicio-panel-${service.slug}`;
      return (
        <div class="border-t border-gray-200 py-10 first:border-t-0 md:py-14">
          <div class="grid items-stretch gap-8 md:grid-cols-2 md:gap-12">
            {/* Ticket: sin href, es un toggle interactivo */}
            <div class={reversed ? "md:order-2" : "md:order-1"}>
              <div class="flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-7 shadow-sm transition-shadow duration-300 hover:shadow-xl md:p-8">
                <div class="flex items-start gap-4">
                  <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-brand-orange/10">
                    <i class={`ti ${service.icon} text-2xl text-brand-orange`} aria-hidden="true"></i>
                  </span>
                  <div class="flex-1">
                    <div class="flex items-start justify-between gap-3">
                      <h3 class="text-xl font-bold text-brand-navy md:text-2xl">{service.title}</h3>
                      <span class="font-display text-2xl font-bold text-gray-200">{service.number}</span>
                    </div>
                    <p class="mt-2 text-sm leading-relaxed text-brand-navy/70 md:text-base">
                      {problemTexts[i]}
                    </p>
                  </div>
                </div>

                <button
                  type="button"
                  data-service-toggle
                  aria-expanded="false"
                  aria-controls={panelId}
                  class="service-toggle mt-6 inline-flex w-fit items-center gap-1.5 rounded-full bg-brand-orange px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-orange/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-orange"
                >
                  Solución NeverBlanc
                  <i
                    class="ti ti-chevron-down text-base transition-transform duration-300"
                    aria-hidden="true"
                  ></i>
                </button>
              </div>
            </div>

            {/* Panel de solución: composición propia del servicio, oculta hasta pulsar el toggle */}
            <div class={reversed ? "md:order-1" : "md:order-2"}>
              <div id={panelId} data-service-panel hidden class="h-full min-h-[16rem]">
                <ServiceScene variant={service.slug as "estrategia" | "contenido" | "gestion-equipo"} />
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function playScene(panel: HTMLElement) {
    const scene = panel.querySelector<HTMLElement>("[data-service-scene]");
    if (!scene) return;
    const animated = scene.querySelectorAll<HTMLElement>(".scene-item");
    animated.forEach((el) => {
      el.classList.remove("scene-play");
      void el.offsetWidth;
      el.classList.add("scene-play");
    });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-service-toggle]").forEach((btn) => {
    const panelId = btn.getAttribute("aria-controls");
    const panel = panelId ? document.getElementById(panelId) : null;
    if (!panel) return;

    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      const next = !isOpen;
      btn.setAttribute("aria-expanded", String(next));

      if (next) {
        panel.hidden = false;
        if (!reducedMotion) {
          panel.classList.add("opacity-0", "-translate-y-2");
          requestAnimationFrame(() => {
            panel.classList.add("transition-all", "duration-300", "ease-out");
            panel.classList.remove("opacity-0", "-translate-y-2");
          });
          playScene(panel);
        }
      } else {
        panel.hidden = true;
        panel.classList.remove(
          "opacity-0",
          "-translate-y-2",
          "transition-all",
          "duration-300",
          "ease-out"
        );
      }
    });
  });
</script>

<style>
  .service-toggle[aria-expanded="true"] i {
    transform: rotate(180deg);
  }
</style>
