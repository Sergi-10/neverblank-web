---
import { services, PRICING_ROUTE } from "../data/site";

// Las tres primeras tarjetas salen de la misma fuente que sus páginas.
// La de Precios va destacada en azul marino para romper la retícula.
const cards = [
  ...services.map((service) => ({
    number: service.number,
    title: service.title,
    tagline: service.tagline,
    icon: service.icon,
    href: service.route,
    cta: "Descúbrelo",
    featured: false,
  })),
  {
    number: "04",
    title: "Precios",
    tagline:
      "Planes que se adaptan a tu ritmo, desde el freelance en solitario hasta la agencia con quince cuentas.",
    icon: "ti-tag",
    href: PRICING_ROUTE,
    cta: "Ver planes y precios",
    featured: true,
  },
];

// Cada nota con un tono distinto de la paleta de marca.
const postIts = [
  {
    title: "Servicios",
    text: "Todo en un mismo sitio: estrategia, contenido, calendario y equipo.",
    bg: "bg-brand-orange-light",
  },
  {
    title: "Multicliente",
    text: "Un perfil, una estrategia y un calendario por cada cliente de tu agencia.",
    bg: "bg-brand-gradient-blue/25",
  },
  {
    title: "Flujo de aprobación",
    text: "Pendiente, aprobado, publicado. Nada sale sin que tú lo revises.",
    bg: "bg-brand-gradient-turquoise/25",
  },
  {
    title: "Gestión de equipo",
    text: "Varios usuarios, roles de agencia, todo el equipo sobre el mismo calendario.",
    bg: "bg-stone-200",
  },
];
---

<section id="servicios" class="scroll-mt-16 bg-brand-bg">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="text-center text-3xl font-bold text-brand-navy md:text-4xl">
      Todo lo que necesitas, nada que sobre
    </h2>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {cards.map((card) => (
        <a
          href={card.href}
          class={`service-card group relative flex flex-col overflow-hidden rounded-2xl transition-all duration-300 ease-out hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-orange ${
            card.featured
              ? "bg-brand-navy shadow-[0_20px_45px_-20px_rgba(20,40,60,0.5)] hover:shadow-[0_28px_60px_-16px_rgba(20,40,60,0.6)]"
              : "border border-gray-200 bg-white shadow-sm hover:border-brand-orange/30 hover:shadow-xl"
          }`}
        >
          <span
            class={`h-1.5 w-full shrink-0 ${card.featured ? "bg-white/25" : "bg-brand-orange"}`}
            aria-hidden="true"
          >
          </span>

          <div class="flex flex-1 flex-col gap-5 p-7 sm:flex-row sm:items-start md:p-8">
            <span
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl ${card.featured ? "bg-white/10" : "bg-brand-orange/10"}`}
            >
              <i
                class={`ti ${card.icon} text-2xl ${card.featured ? "text-white" : "text-brand-orange"}`}
                aria-hidden="true"
              ></i>
            </span>

            <div class="flex flex-1 flex-col">
              <div class="flex items-start justify-between gap-3">
                <h3 class={`text-xl font-bold md:text-2xl ${card.featured ? "text-white" : "text-brand-navy"}`}>
                  {card.title}
                </h3>
                <span
                  class={`font-display text-3xl font-bold ${card.featured ? "text-white/15" : "text-gray-200"}`}
                >
                  {card.number}
                </span>
              </div>

              <p class={`mt-2 text-sm leading-relaxed md:text-base ${card.featured ? "text-white/70" : "text-brand-navy/70"}`}>
                {card.tagline}
              </p>

              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-orange">
                {card.cta}
                <i
                  class="ti ti-arrow-narrow-right text-base transition-transform duration-300 group-hover:translate-x-1"
                  aria-hidden="true"
                ></i>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>

  {/*
    Bloque final a ancho completo. El ordenador es hijo directo de este
    envoltorio (no de la columna centrada), así el recorte ocurre en el
    borde real de la página: entra desde fuera por la izquierda, se
    recorta ahí mismo (overflow-x-clip) y muestra sus dos tercios
    derechos con la altura completa. Debajo de md se ve entero, en flujo.
  */}
  <div class="relative overflow-x-clip overflow-y-visible py-10 md:py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-6 md:hidden">
      <img
        src="/ordenador_servicios.png"
        alt="NeverBlanc en tu ordenador"
        class="mx-auto h-auto w-full max-w-[24rem] rounded-2xl object-contain drop-shadow-xl"
      />
    </div>

    <img
      src="/ordenador_servicios.png"
      alt="NeverBlanc en tu ordenador"
      class="pointer-events-none absolute left-0 top-1/2 hidden h-[24rem] w-auto max-w-none -translate-x-1/3 -translate-y-1/2 object-contain drop-shadow-xl md:block lg:h-[34rem]"
    />

    <div class="relative z-10 mx-auto flex max-w-6xl items-center px-6 md:min-h-[24rem] lg:min-h-[34rem]">
      <div class="mx-auto grid max-w-[26rem] grid-cols-2 gap-4 sm:max-w-[30rem] sm:gap-5 md:mx-0 md:max-w-none md:gap-6 md:pl-[21rem] lg:gap-7 lg:pl-[31rem]">
        {postIts.map((note, i) => (
          <div
            class:list={[
              "post-it min-h-[8rem] rounded-sm p-5 shadow-lg sm:min-h-[9rem] sm:p-6 md:min-h-[10rem] md:p-7 lg:min-h-[11rem]",
              note.bg,
              i % 2 === 0 ? "rotate-1" : "-rotate-1",
            ]}
          >
            <h3 class="text-lg font-bold text-brand-navy sm:text-xl md:text-2xl">{note.title}</h3>
            <p class="mt-2 text-sm leading-snug text-brand-navy/80 sm:text-base md:text-lg">{note.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* En móvil se reduce la rotación del post-it para evitar cortes laterales. */
  @media (max-width: 767px) {
    .post-it {
      transform: rotate(0.5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transition: none;
    }

    .service-card:hover {
      transform: none;
    }
  }
</style>
