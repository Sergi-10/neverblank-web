---
import { services } from "../data/site";
---

<section class="relative overflow-x-clip bg-brand-bg">
  <div class="relative z-10 mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <div class="reveal-up flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-8 shadow-[0_32px_64px_-12px_rgba(20,40,60,0.45)] transition-shadow duration-300 hover:shadow-xl">
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-brand-orange/10">
            <i class={`ti ${service.icon} text-2xl text-brand-orange`} aria-hidden="true"></i>
          </span>
          <h3 class="mt-5 text-lg font-bold text-brand-navy md:text-xl">{service.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-brand-navy/70 md:text-base">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
