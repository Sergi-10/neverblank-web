---
const columns = [
  {
    number: "01",
    title: "Estrategia",
    description:
      "Perfil de cliente, público objetivo, tono de marca y competencia — generado con un cuestionario guiado por IA, siempre editable. Define la base sobre la que se construye todo el contenido de cada cuenta.",
    icon: "clipboard",
  },
  {
    number: "02",
    title: "Contenido",
    description:
      "Calendario mensual completo por cliente: carrusel, reel, story o hilo, con copy, texto de cada diapositiva y hashtags ya pensados. Genera un mes entero de publicaciones en minutos, no en días.",
    icon: "calendar",
  },
  {
    number: "03",
    title: "Gestión de equipo",
    description:
      "Varios clientes, varios usuarios, roles de agencia. Todo el equipo trabajando sobre el mismo calendario, con estados de aprobación y revisión, sin salir de la plataforma.",
    icon: "users",
  },
  {
    number: "04",
    title: "Servicios",
    description:
      "Todo lo que necesitas para dejar de gestionar redes sociales a mano. Una sola herramienta que sustituye el Word, el Excel, el WhatsApp y los prompts sueltos.",
    icon: "gear",
  },
];
---

<section id="servicios" class="relative scroll-mt-16 overflow-hidden mt-16">
  <div
    id="servicios-bg"
    class="absolute inset-0 bg-cover bg-center"
    style="background-image: url('/calendario_bg_brighter.jpg'); transform: scale(1); transform-origin: center;"
    aria-hidden="true"
  >
  </div>

  <div class="servicios-grid relative grid md:grid-cols-4">
    {columns.map((col, i) => (
      <div class="servicios-col relative overflow-hidden border-b border-white/20 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0">
        <div class="servicios-overlay pointer-events-none absolute inset-0 bg-black/60"></div>

        <div class="servicios-content relative z-10 flex min-h-[420px] flex-col justify-between p-8 pt-16 md:p-10 md:pt-20">
          <div>
            <div class="flex items-start justify-between">
              {col.icon === "clipboard" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-12 w-12 text-brand-orange">
                  <rect x="6" y="4" width="12" height="17" rx="1.5" />
                  <path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1" />
                  <path d="M9 12l2 2 4-4" />
                </svg>
              )}
              {col.icon === "calendar" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-12 w-12 text-brand-orange">
                  <rect x="3.5" y="5" width="17" height="15" rx="1.5" />
                  <path d="M3.5 9.5h17" />
                  <path d="M8 3v3M16 3v3" />
                  <path d="M8 13.5h.01M12 13.5h.01M16 13.5h.01M8 16.5h.01M12 16.5h.01M16 16.5h.01" />
                </svg>
              )}
              {col.icon === "users" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-12 w-12 text-brand-orange">
                  <circle cx="9" cy="8" r="3" />
                  <path d="M3.5 20c0-3.31 2.46-6 5.5-6s5.5 2.69 5.5 6" />
                  <circle cx="17" cy="9" r="2.5" />
                  <path d="M15.5 14.2c2.53.4 4.5 2.66 4.5 5.8" />
                </svg>
              )}
              {col.icon === "gear" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-12 w-12 text-brand-orange">
                  <circle cx="12" cy="12" r="3" />
                  <path d="M12 3v2.2M12 18.8V21M21 12h-2.2M5.2 12H3M18.2 5.8l-1.55 1.55M7.35 16.65 5.8 18.2M18.2 18.2l-1.55-1.55M7.35 7.35 5.8 5.8" />
                </svg>
              )}
              <span class="font-display text-5xl font-extrabold text-white/20">{col.number}</span>
            </div>

            <h3 class="mt-6 text-xl font-bold text-white">{col.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-white/70">{col.description}</p>
          </div>

          {i === 3 && (
            <a
              href="#precios"
              class="mt-3 inline-flex items-center gap-1 text-lg font-semibold text-brand-orange transition-all hover:gap-2 hover:underline"
            >
              Ver precios <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const bg = document.getElementById("servicios-bg");
  let ticking = false;

  const updateZoom = () => {
    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    const progress = maxScroll > 0 ? Math.min(Math.max(window.scrollY / maxScroll, 0), 1) : 0;
    const scale = 1 + progress * 0.12;
    if (bg) bg.style.transform = `scale(${scale})`;
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      requestAnimationFrame(updateZoom);
      ticking = true;
    }
  };

  updateZoom();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  .servicios-overlay {
    transition: background-color 500ms ease;
  }

  .servicios-content {
    transition:
      transform 500ms ease,
      opacity 500ms ease;
  }

  .servicios-grid:hover .servicios-overlay {
    background-color: rgb(0 0 0 / 0.1);
  }

  .servicios-grid:hover .servicios-content {
    transform: translateY(-100%);
    opacity: 0;
  }

  .servicios-col:hover .servicios-overlay {
    background-color: rgb(0 0 0 / 0.6);
  }

  .servicios-col:hover .servicios-content {
    transform: translateY(0);
    opacity: 1;
  }
</style>
