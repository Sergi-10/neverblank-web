---
import { services, PRICING_ROUTE } from "../data/site";

// Las tres primeras tarjetas salen de la misma fuente que sus páginas.
const cards = [
  ...services.map((service) => ({
    number: service.number,
    title: service.title,
    tagline: service.tagline,
    icon: service.icon,
    href: service.route,
    cta: "Descúbrelo →",
  })),
  {
    number: "04",
    title: "Precios",
    tagline:
      "Planes que se adaptan a tu ritmo, desde el freelance en solitario hasta la agencia con quince cuentas.",
    icon: "ti-tag",
    href: PRICING_ROUTE,
    cta: "Ver planes y precios →",
  },
];

// Cada nota con un tono distinto de la paleta de marca.
const postIts = [
  {
    title: "Servicios",
    text: "Todo en un mismo sitio: estrategia, contenido, calendario y equipo.",
    bg: "bg-brand-orange-light",
  },
  {
    title: "Multicliente",
    text: "Un perfil, una estrategia y un calendario por cada cliente de tu agencia.",
    bg: "bg-brand-gradient-blue/25",
  },
  {
    title: "Flujo de aprobación",
    text: "Pendiente, aprobado, publicado. Nada sale sin que tú lo revises.",
    bg: "bg-brand-gradient-turquoise/25",
  },
  {
    title: "Gestión de equipo",
    text: "Varios usuarios, roles de agencia, todo el equipo sobre el mismo calendario.",
    bg: "bg-stone-200",
  },
];
---

<section id="servicios" class="scroll-mt-16 bg-brand-bg">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="text-center text-3xl font-bold text-brand-navy md:text-4xl">
      Todo lo que necesitas, nada que sobre
    </h2>

    <div class="mt-12 grid gap-6 md:grid-cols-4">
      {cards.map((card) => (
        <div
          class="service-card flex flex-col rounded-xl border-2 border-gray-200 bg-white p-6 transition-all duration-300 ease-out hover:scale-105 hover:border-brand-navy hover:bg-brand-navy"
        >
          <div class="flex items-start justify-between">
            <i class={`ti ${card.icon} text-[48px] leading-none text-brand-orange`} aria-hidden="true"></i>
            <span class="card-number font-display text-4xl font-bold text-gray-300">
              {card.number}
            </span>
          </div>

          <h3 class="card-title mt-6 text-xl font-bold text-brand-navy">{card.title}</h3>
          <p class="card-text mt-3 grow text-sm leading-relaxed text-brand-navy/70">
            {card.tagline}
          </p>

          <a
            href={card.href}
            class="mt-6 inline-block self-start rounded-full bg-brand-orange px-5 py-2.5 text-sm font-semibold text-white transition-shadow hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-orange"
          >
            {card.cta}
          </a>
        </div>
      ))}
    </div>

  </div>

  {/*
    Bloque final a ancho completo. Debajo de lg el ordenador se muestra
    completo y en flujo normal (móvil y tablet, sin recorte); desde lg se
    recorta un tercio por la izquierda dentro de su propio contenedor
    (overflow-x-clip), de forma que el borde derecho visible queda pegado
    a los post-its sin depender del borde del viewport.
  */}
  <div class="relative overflow-x-clip py-10 md:py-14 lg:py-12">
    <div class="relative z-10 mx-auto max-w-6xl px-6 pb-10 md:pb-14 lg:pb-12">
      <div class="grid items-center gap-8 md:gap-10 lg:grid-cols-[auto_minmax(0,1fr)] lg:gap-5">
        <div>
          <img
            src="/ordenador_servicios.png"
            alt="NeverBlanc en tu ordenador"
            class="mx-auto h-auto w-full max-w-[24rem] rounded-2xl object-contain shadow-lg md:max-w-[32rem] lg:hidden"
          />

          <div class="relative hidden overflow-x-clip overflow-y-visible lg:block lg:h-[36rem] lg:w-[36rem]">
            <img
              src="/ordenador_servicios.png"
              alt="NeverBlanc en tu ordenador"
              class="pointer-events-none absolute left-0 top-0 h-full w-auto max-w-none -translate-x-1/3 object-contain"
            />
          </div>
        </div>

        <div class="mx-auto grid max-w-[26rem] grid-cols-2 gap-4 sm:max-w-[30rem] sm:gap-5 md:max-w-[34rem] md:gap-6 lg:mx-0 lg:max-w-[40rem] lg:gap-7">
          {postIts.map((note, i) => (
            <div
              class:list={[
                "post-it min-h-[8rem] rounded-sm p-5 shadow-lg sm:min-h-[9rem] sm:p-6 md:min-h-[10rem] md:p-7 lg:min-h-[11rem]",
                note.bg,
                i % 2 === 0 ? "rotate-1" : "-rotate-1",
              ]}
            >
              <h3 class="text-lg font-bold text-brand-navy sm:text-xl md:text-2xl">{note.title}</h3>
              <p class="mt-2 text-sm leading-snug text-brand-navy/80 sm:text-base md:text-lg">{note.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* En hover la tarjeta pasa a azul marino: texto en blanco, icono naranja
     y número en white/30. Sin hover todo el contenido ya es legible. */
  .service-card:hover .card-title {
    color: #ffffff;
  }

  .service-card:hover .card-text {
    color: rgb(255 255 255 / 0.8);
  }

  .service-card:hover .card-number {
    color: rgb(255 255 255 / 0.3);
  }

  /* En móvil se reduce la rotación del post-it para evitar cortes laterales. */
  @media (max-width: 767px) {
    .post-it {
      transform: rotate(0.5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transition: none;
    }

    .service-card:hover {
      transform: none;
    }
  }
</style>
