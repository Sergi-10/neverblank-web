---
import TypewriterLine from "./TypewriterLine.astro";

interface Props {
  /** Título principal del hero (único h1 de la página) */
  title: string;
  /** Ruta de la imagen de fondo dentro de /public */
  image: string;
  /** background-position ajustado a cada imagen */
  position?: string;
  words: string[];
  suffix: string;
  prefix?: string;
  /** Opacidad del velo navy sobre la imagen */
  overlayClass?: string;
}

const {
  title,
  image,
  position = "center",
  words,
  suffix,
  prefix = "Es la hora de",
  overlayClass = "bg-brand-navy/72",
} = Astro.props;
---

<section
  class="relative flex min-h-[22rem] items-center justify-center overflow-hidden bg-brand-navy px-6 pb-10 pt-24 sm:min-h-[26rem] md:min-h-[60vh] md:pb-16 md:pt-32"
>
  <div
    class="absolute inset-0 bg-cover"
    style={`background-image: url('${image}'); background-position: ${position};`}
    aria-hidden="true"
  >
  </div>
  <div class={`absolute inset-0 ${overlayClass}`} aria-hidden="true"></div>

  <div class="relative z-10 mx-auto w-full max-w-4xl text-center">
    <h1 class="font-display text-3xl font-bold text-white sm:text-4xl md:text-6xl lg:text-7xl">
      {title}
    </h1>

    <TypewriterLine
      prefix={prefix}
      words={words}
      suffix={suffix}
      class="mt-5 text-lg font-light sm:text-xl md:mt-6 md:text-3xl"
    />
  </div>
</section>
