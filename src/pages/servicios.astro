---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Servicios from "../components/Servicios.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Servicios — NeverBlanc">
  <Header />

  <section class="relative flex min-h-[60vh] items-center justify-center overflow-hidden bg-brand-navy pt-32">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/servicios_header.png');"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-brand-navy/70" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <h1 class="font-display text-5xl font-bold text-white md:text-7xl">
        Servicios de NeverBlanc
      </h1>
      <p class="mt-6 text-2xl font-light text-white md:text-3xl">
        Es la hora de{" "}
        <span class="text-brand-orange" id="tw-word"></span><span class="tw-cursor">|</span>{" "}
        tu negocio
      </p>
    </div>
  </section>

  <Servicios />

  <Footer />
</Layout>

<script>
  const words = ["impulsar", "automatizar", "consolidar"];
  const wordEl = document.getElementById("tw-word");
  let wordIndex = 0;
  let charIndex = 0;

  function type() {
    if (!wordEl) return;
    const word = words[wordIndex];
    wordEl.textContent = word.slice(0, charIndex);
    if (charIndex < word.length) {
      charIndex++;
      setTimeout(type, 80);
    } else {
      setTimeout(erase, 1800);
    }
  }

  function erase() {
    if (!wordEl) return;
    const word = words[wordIndex];
    wordEl.textContent = word.slice(0, charIndex);
    if (charIndex > 0) {
      charIndex--;
      setTimeout(erase, 50);
    } else {
      wordIndex = (wordIndex + 1) % words.length;
      setTimeout(type, 300);
    }
  }

  type();
</script>

<style>
  .tw-cursor {
    animation: tw-blink 1s steps(1) infinite;
  }

  @keyframes tw-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
</style>
