---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ServiceHero from "../components/ServiceHero.astro";
import Servicios from "../components/Servicios.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Servicios — NeverBlanc"
  description="Estrategia, contenido y gestión de equipo: todo lo que necesitas para dejar de gestionar redes sociales a mano."
>
  <Header />

  <ServiceHero
    title="Servicios de NeverBlanc"
    image="/servicios_header.png"
    position="50% 45%"
    words={["impulsar", "automatizar", "consolidar"]}
    suffix="tu negocio"
  />

  <Servicios />

  <Footer />
</Layout>
