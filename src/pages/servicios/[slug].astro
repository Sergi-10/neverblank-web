---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import ServiceContent from "../../components/ServiceContent.astro";
import Footer from "../../components/Footer.astro";
import { services } from "../../data/site";

// Una sola plantilla genera /servicios/estrategia, /servicios/contenido
// y /servicios/gestion-equipo a partir de src/data/site.ts.
export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<Layout title={`${service.title} — NeverBlanc`} description={service.description}>
  <Header />

  <ServiceHero
    title={service.title}
    image={service.heroImage}
    position={service.heroPosition}
    words={service.words}
    suffix={service.suffix}
  />

  <ServiceContent
    heading={service.title}
    paragraphs={service.paragraphs}
    idPrefix={service.slug}
  />

  <Footer />
</Layout>
