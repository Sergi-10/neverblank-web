---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PricingPlans from "../components/PricingPlans.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Precios — NeverBlanc"
  description="Planes de NeverBlanc para freelances y agencias, desde 19€/mes. Sin permanencia: cambia o cancela cuando quieras."
>
  <Header />

  <section
    class="relative flex min-h-[22rem] items-center justify-center overflow-hidden bg-brand-navy px-6 pb-10 pt-16 sm:min-h-[26rem] md:min-h-[60vh] md:pb-16 md:pt-24"
  >
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/precios_header.png');"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-brand-navy/72" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto w-full max-w-4xl text-center">
      <h1 class="font-display text-4xl font-bold text-white sm:text-5xl md:text-7xl">Precios</h1>
      <p class="mt-5 text-center text-xl text-white/90 sm:text-2xl md:text-3xl">
        Planes para cada etapa
      </p>
      <p class="mt-3 text-center text-base text-white/60 md:text-lg">
        Sin permanencia. Cambia o cancela cuando quieras.
      </p>
    </div>
  </section>

  <div class="bg-brand-orange py-3 text-center text-sm font-medium text-white md:py-4">
    Todos los planes incluyen soporte y actualizaciones
  </div>

  <section class="bg-brand-bg py-12 md:py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="font-display text-3xl font-bold text-brand-navy md:text-4xl">
        Empieza pequeño. Escala cuando tu equipo y tus <span class="text-brand-orange">marcas crezcan</span>.
      </h2>
    </div>
  </section>

  <section class="mt-2 pb-16 md:pb-24">
    <div class="mx-auto max-w-6xl px-6">
      <PricingPlans />
    </div>
  </section>

  <Footer />
</Layout>
