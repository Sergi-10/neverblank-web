---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { APP_REGISTER_URL, EXTERNAL_LINK_ATTRS } from "../data/site";

const plans = [
  {
    name: "Lite",
    description: "Para freelances que arrancan solos",
    price: "29€",
    suffix: "/mes",
    features: [
      "1 miembro",
      "3 clientes",
      "20 créditos IA/mes",
      "Calendario por cliente",
      "Estrategia por cliente",
    ],
    cta: "Empezar con Lite",
    highlighted: false,
  },
  {
    name: "Pro",
    description: "Para agencias en crecimiento",
    price: "79€",
    suffix: "/mes",
    features: [
      "3 miembros de equipo",
      "15 clientes",
      "200 créditos IA/mes",
      "Calendario por cliente",
      "Flujo de aprobación",
      "Roles de equipo",
      "Estados dinámicos",
    ],
    cta: "Empezar con Pro",
    highlighted: true,
  },
  {
    name: "Agency",
    description: "Para agencias establecidas",
    price: "199€",
    suffix: "/mes",
    features: [
      "10 miembros de equipo",
      "Clientes ilimitados",
      "1000 créditos IA/mes",
      "Calendario por cliente",
      "Flujo de aprobación",
      "Equipo multi-rol",
      "Soporte prioritario",
    ],
    cta: "Empezar con Agency",
    highlighted: false,
  },
];
---

<Layout
  title="Precios — NeverBlanc"
  description="Planes de NeverBlanc para freelances y agencias. Sin permanencia: cambia o cancela cuando quieras."
>
  <Header />

  <section
    class="relative flex min-h-[22rem] items-center justify-center overflow-hidden bg-brand-navy px-6 pb-10 pt-16 sm:min-h-[26rem] md:min-h-[60vh] md:pb-16 md:pt-24"
  >
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/precios_header.png');"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-brand-navy/72" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto w-full max-w-4xl text-center">
      <h1 class="font-display text-4xl font-bold text-white sm:text-5xl md:text-7xl">Precios</h1>
      <p class="mt-5 text-center text-xl text-white/90 sm:text-2xl md:text-3xl">
        Planes para cada etapa
      </p>
      <p class="mt-3 text-center text-base text-white/60 md:text-lg">
        Sin permanencia. Cambia o cancela cuando quieras.
      </p>
    </div>
  </section>

  <div class="bg-brand-orange py-3 text-center text-sm font-medium text-white md:py-4">
    Todos los planes incluyen soporte y actualizaciones
  </div>

  <section class="bg-brand-bg py-12 md:py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="font-display text-3xl font-bold text-brand-navy md:text-4xl">
        Elige el plan que mejor encaja con tu <span class="text-brand-orange">agencia</span>
      </h2>
      <p class="mt-3 text-base text-brand-navy/80 md:text-lg">
        Empieza con lo que necesitas hoy y cambia de plan cuando tu equipo y tus clientes crezcan.
      </p>
    </div>
  </section>

  <section class="mt-2 pb-16 md:pb-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-8 md:grid-cols-3">
        {plans.map((plan) => (
          <div
            class="plan-card relative rounded-2xl border border-gray-200 bg-white p-8 shadow-sm transition-all duration-300 ease-out hover:scale-105 hover:border-brand-navy hover:bg-brand-navy"
          >
            {plan.highlighted && (
              <span
                class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand-orange px-3 py-1 text-xs font-semibold text-white"
              >
                Más popular
              </span>
            )}

            <h2 class="plan-title font-display text-2xl font-bold text-brand-navy">{plan.name}</h2>
            <p class="plan-desc mt-1 text-sm text-brand-navy/70">{plan.description}</p>

            <p class="mt-6">
              <span class="font-display text-4xl font-extrabold text-brand-orange">
                {plan.price}
              </span>
              <span class="plan-suffix ml-1 text-sm text-brand-navy/60">{plan.suffix}</span>
            </p>

            <ul class="mt-6 space-y-3">
              {plan.features.map((feature) => (
                <li class="plan-feature flex items-start gap-2 text-sm text-brand-navy/80">
                  <i class="ti ti-check mt-0.5 shrink-0 text-brand-orange" aria-hidden="true"></i>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href={APP_REGISTER_URL}
              target={EXTERNAL_LINK_ATTRS.target}
              rel={EXTERNAL_LINK_ATTRS.rel}
              class:list={[
                "mt-8 block w-full rounded-full px-6 py-3 text-center text-base font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-orange",
                plan.highlighted
                  ? "bg-brand-orange text-white hover:bg-brand-orange/90"
                  : "border-2 border-brand-orange bg-transparent text-brand-orange hover:bg-brand-orange hover:text-white",
              ]}
            >
              {plan.cta}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* En hover la tarjeta pasa a azul marino: el texto interior se aclara,
     el precio y los checks se quedan en naranja. Sin hover todo es legible. */
  .plan-card:hover .plan-title,
  .plan-card:hover .plan-desc,
  .plan-card:hover .plan-suffix,
  .plan-card:hover .plan-feature {
    color: #ffffff;
  }

  .plan-card:hover .plan-desc,
  .plan-card:hover .plan-suffix {
    color: rgb(255 255 255 / 0.7);
  }

  .plan-card:hover .plan-feature {
    color: rgb(255 255 255 / 0.85);
  }

  @media (prefers-reduced-motion: reduce) {
    .plan-card {
      transition: none;
    }

    .plan-card:hover {
      transform: none;
    }
  }
</style>
