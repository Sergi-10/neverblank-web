---
import "../styles/global.css";
import { CONTACT_EMAIL, plans } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NeverBlanc Web",
  description = "La plataforma para agencias y freelances que necesitan tener el control total de sus clientes, publicaciones y estrategia.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = "NeverBlanc";

// JSON-LD básico, sin librería. Se repite en cada página (es ligero y válido
// tenerlo site-wide); los planes salen de la misma fuente que /precios y
// la sección #precios de la home.
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: Astro.site?.toString(),
  email: CONTACT_EMAIL,
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: Astro.site?.toString(),
};

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: siteName,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  offers: plans.map((plan) => ({
    "@type": "Offer",
    name: plan.name,
    price: plan.price.replace("€", ""),
    priceCurrency: "EUR",
    description: plan.description,
  })),
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css"
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </head>
  <body class="font-sans">
    <slot />
  </body>
</html>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle("reveal-visible", entry.isIntersecting);
      });
    },
    { threshold: 0.15 }
  );

  document.querySelectorAll(".reveal-up").forEach((el) => observer.observe(el));
</script>

<style is:global>
  .reveal-up {
    opacity: 0;
    transform: translateY(72px);
    transition:
      opacity 900ms ease,
      transform 900ms ease;
  }

  .reveal-up.reveal-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
